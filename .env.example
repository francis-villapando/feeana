# Supabase (VITE_ prefix required for client-side access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=pk.anon.youranonkey
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI (for local dev/migrations)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Application secrets
SERVER_SALT=some-long-random-string-or-hex

# Faculty domain restriction (unset = allow any email for testing)
# VITE_FACULTY_DOMAIN=pnc.edu.ph

# Developer account (unset = dev@feeana.me)
# VITE_DEV_EMAIL=dev@feeana.me

# Feature flags
FRONTEND_USE_BACKEND=false
FEATURE_REAL_ANALYSIS=false

# Optional
SENTRY_DSN=