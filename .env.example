# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=pk.anon.youranonkey
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI (for local dev/migrations)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Application secrets
SERVER_SALT=some-long-random-string-or-hex

# Feature flags
FRONTEND_USE_BACKEND=false
FEATURE_REAL_ANALYSIS=false

# Optional
SENTRY_DSN=
